# Pflicht
LLM_API_KEY=sk-...
LLM_MODEL=Qwen3.8-27B-NVFP4

# Optional (Standardwerte stehen dahinter)
# LLM_BASE_URL=https://llm.aihosting.mittwald.de/v1
# LLM_ENABLE_THINKING=true
# LLM_REASONING_EFFORT=medium      # low | medium | xhigh
# LLM_TEMPERATURE=1.0              # ohne Thinking: 0.7
# LLM_TOP_P=0.95                   # ohne Thinking: 0.8
# LLM_TOP_K=20
# LLM_PRESENCE_PENALTY=0.0         # ohne Thinking: 1.5
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_MS=45000
# TEST_PAGE=true
# RATE_LIMIT_SPIN=20/min           # off = keine Begrenzung
# RATE_LIMIT_TEST=10/10min
# TRUST_PROXY=true                 # ohne vorgeschalteten Proxy: false
# PORT=8080
